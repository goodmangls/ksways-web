  "narrative": {
    "northStar": "The Korea Origin Desk",
    "overview": "The site is the desk an overseas forwarder hands Korea-origin cargo to: calm, accountable and operational. Dark navy carries the authority, bronze marks the route and the next action, and paper keeps the working detail readable. Everything on the page should help a partner decide they can rely on this desk, so precise execution detail always beats decoration or repeated badges.",
    "keyCharacteristics": [
      "Narrow navy, bronze, gold and paper palette, with contrast computed rather than eyeballed.",
      "Heavy system-sans headlines over practical body copy, tuned separately for English and Korean.",
      "Hairline rules and full-width rows instead of stacked card grids.",
      "Rounded, high-trust forms: pills for actions, large radii for panels.",
      "One recognizable route motif: the bronze route line."
    ],
    "rules": [
      {
        "name": "The One Desk Rule",
        "body": "Every page presents the same desk: the same header with navigation, the language toggle and the quote CTA, and the same footer. A subpage never gets a reduced header.",
        "section": "overview"
      },
      {
        "name": "The Say It Once Rule",
        "body": "A credential (WCA membership, Ocean · Air, 30+ years) appears once where it does its job: the hero proof strip and the footer credential cards. Other bands carry a concrete fact the strip does not.",
        "section": "overview"
      }
    ],
    "dos": [
      "Do lead with global ocean and air logistics, WCA network, and ocean freight strength.",
      "Do use the official KS WAYS logo assets instead of text placeholders.",
      "Do keep CTAs clear: quote, partner enquiry, schedule consultation.",
      "Do verify mobile typography, CTA stacking, footer links, and proof cards at `390px` width.",
      "Do preserve high contrast between dark surfaces and white/gold text, and verify any accent pairing against the contrast table in **Colors** before shipping.",
      "Do use `KS WAYS` with a space in public-facing brand copy.",
      "Do keep the public tone polished, concise, and partner-ready."
    ],
    "donts": [
      "Do not describe KS WAYS primarily as a Korea-based local company.",
      "Do not spell the visible brand as `KSWAYS`, `KSWays`, or `KS Ways` — `KS WAYS` is the only correct form. Enforced by `src/site-quality.test.ts`, which walks the exported copy data rather than grepping files, so identifiers like `NEXT_PUBLIC_KSWAYS_CALENDLY_URL` do not false-positive.",
      "Do not add arbitrary colors outside the navy/bronze/gold/steel/paper palette.",
      "Do not place white text on the bronze accent (`#B88A5A`); it measures 3.08:1 and fails WCAG AA.",
      "Do not change a palette value in one component only — the palette is asserted site-wide by `src/brand-palette.test.ts`.",
      "Do not distort, recolor, or replace official logo assets with text-only placeholders.",
      "Do not create mobile CTAs that are narrow, cramped, or under `44px` high.",
      "Do not leak internal pricing, margin, or private operational assumptions into public copy.",
      "Do not rely on build success alone for design changes; use screenshot/DOM QA for production-facing UI."
    ]
  }
}
