  "components": [
    {
      "name": "Primary CTA",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Flat bronze pill with ink text and the site's one 16px arrow: quote and contact actions. Full-width below sm.",
      "html": "<a class=\"ds-btn-primary\" href=\"#\">Get a Quote<svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 28px;border-radius:999px;background:var(--ks-accent,#b88a5a);color:var(--ks-navy,#001112);font:800 16px/1 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;text-decoration:none;transition:background-color 150ms cubic-bezier(.4,0,.2,1)}.ds-btn-primary:hover{background:var(--ks-accent-strong,#a5794d)}.ds-btn-primary:focus-visible{outline:3px solid var(--ks-accent-soft,#e7c99a);outline-offset:2px;box-shadow:0 0 0 2px var(--ks-navy,#001112)}"
    },
    {
      "name": "Outline CTA on Navy",
      "kind": "button",
      "refersTo": "button-secondary-dark",
      "description": "Secondary partner or contact action on dark surfaces.",
      "html": "<div style=\"background:var(--ks-navy,#001112);padding:24px\"><a class=\"ds-btn-outline\" href=\"#\">Explore Partner Network</a></div>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 28px;border-radius:999px;border:1px solid rgba(255,255,255,.45);color:#fff;font:700 16px/1 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;text-decoration:none;transition:border-color 150ms,background-color 150ms}.ds-btn-outline:hover{border-color:#fff;background:rgba(255,255,255,.06)}.ds-btn-outline:focus-visible{outline:3px solid var(--ks-accent-soft,#e7c99a);outline-offset:2px;box-shadow:0 0 0 2px var(--ks-navy,#001112)}"
    },
    {
      "name": "Site Header",
      "kind": "nav",
      "description": "The one header every page carries: logo, four nav links (44px targets), language pill, contact pill, quote pill.",
      "html": "<header class=\"ds-nav\"><span class=\"ds-nav-logo\">KS WAYS</span><nav class=\"ds-nav-links\" aria-label=\"Primary navigation\"><a href=\"#\">Company</a><a href=\"#\">Services</a><a href=\"#\">Network</a><a href=\"#\">Solutions</a></nav><div class=\"ds-nav-actions\"><a class=\"ds-nav-lang\" href=\"#\">KR</a><a class=\"ds-nav-contact\" href=\"#\">Contact</a><a class=\"ds-nav-quote\" href=\"#\">Get a quote</a></div></header>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;gap:16px;height:80px;padding:0 24px;background:var(--ks-navy,#001112);color:#fff;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}.ds-nav-logo{font-weight:900;letter-spacing:.04em}.ds-nav-links{display:flex;gap:32px;font-size:14px;font-weight:600}.ds-nav-links a{display:inline-flex;align-items:center;min-height:44px;color:rgba(255,255,255,.78);text-decoration:none;transition:color 150ms}.ds-nav-links a:hover{color:#fff}.ds-nav-actions{display:flex;align-items:center;gap:10px}.ds-nav-lang{display:grid;place-items:center;height:44px;min-width:44px;padding:0 16px;border-radius:999px;border:1px solid rgba(255,255,255,.3);color:#fff;font-size:14px;font-weight:700;text-decoration:none;transition:border-color 150ms}.ds-nav-lang:hover{border-color:rgba(255,255,255,.7)}.ds-nav-contact{display:inline-flex;align-items:center;min-height:44px;padding:0 20px;border-radius:999px;border:1px solid rgba(255,255,255,.45);color:#fff;font-size:14px;font-weight:700;text-decoration:none;transition:border-color 150ms,background-color 150ms}.ds-nav-contact:hover{border-color:#fff;background:rgba(255,255,255,.06)}.ds-nav-quote{display:inline-flex;align-items:center;min-height:44px;padding:0 20px;border-radius:999px;background:var(--ks-accent,#b88a5a);color:var(--ks-navy,#001112);font-size:14px;font-weight:800;white-space:nowrap;text-decoration:none;transition:background-color 150ms}.ds-nav-quote:hover{background:var(--ks-accent-strong,#a5794d)}.ds-nav a:focus-visible{outline:3px solid var(--ks-accent-soft,#e7c99a);outline-offset:2px;box-shadow:0 0 0 2px var(--ks-navy,#001112)}"
    },
    {
      "name": "Quote Field",
      "kind": "input",
      "refersTo": "form-field",
      "description": "Label above, paper field with a control-boundary border, regular-weight muted placeholder starting with 'e.g.', format hint in the helper line.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Pickup place</span><input class=\"ds-field-input\" placeholder=\"e.g. Warehouse address\"><span class=\"ds-field-help\">Add the pickup PIC name and phone.</span></label>",
      "css": ".ds-field{display:block;max-width:360px;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}.ds-field-label{display:block;font-size:14px;font-weight:900;color:rgba(0,17,18,.76)}.ds-field-input{margin-top:8px;width:100%;min-height:48px;padding:12px 16px;border:1px solid var(--ks-border-control,#808b8d);border-radius:16px;background:var(--ks-paper,#f4f7f6);color:var(--ks-navy,#001112);font-size:16px;font-weight:600;transition:border-color 150ms,background-color 150ms}.ds-field-input::placeholder{color:var(--ks-muted,#677173);font-weight:400}.ds-field-input:focus{border-color:var(--ks-accent,#b88a5a);background:#fff}.ds-field-input:focus-visible{outline:3px solid var(--ks-accent-soft,#e7c99a);outline-offset:2px;box-shadow:0 0 0 2px var(--ks-navy,#001112)}.ds-field-help{display:block;margin-top:8px;font-size:12px;font-weight:600;line-height:1.625;color:rgba(0,17,18,.66)}"
    },
    {
      "name": "Service Row",
      "kind": "custom",
      "description": "Numbered full-width service row on paper: mono index, title, body, arrow disc that fills bronze on hover (hidden below sm).",
      "html": "<a class=\"ds-row\" href=\"#\"><span class=\"ds-row-index\">01</span><span class=\"ds-row-title\">Ocean Freight</span><span class=\"ds-row-body\">Primary FCL/LCL strength with carrier coordination, loading review, and partner handoff.</span><span class=\"ds-row-arrow\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></a><a class=\"ds-row\" href=\"#\"><span class=\"ds-row-index\">05</span><span class=\"ds-row-title\">BridgeLogis</span><span class=\"ds-row-body\">External service, opens in a new tab.</span><span class=\"ds-row-arrow\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 11l6-6M6 5h5v5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></a>",
      "css": ".ds-row{display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;padding:28px 24px;border-top:1px solid var(--ks-border-light,#d9e2e0);background:var(--ks-paper,#f4f7f6);color:var(--ks-navy,#001112);text-decoration:none;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;transition:background-color 150ms}.ds-row:hover{background:#fff}.ds-row-index{width:40px;flex-shrink:0;font:600 13px/1.4 ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;color:var(--ks-accent-ink,#805d3b)}.ds-row-title{flex:1 1 200px;font-size:26px;font-weight:800;line-height:1.15;letter-spacing:-.02em}.ds-row-body{flex:999 1 320px;font-size:16px;line-height:1.6;color:rgba(0,17,18,.76)}.ds-row-arrow{display:grid;place-items:center;width:44px;height:44px;flex-shrink:0;border-radius:999px;border:1px solid rgba(0,17,18,.2);transition:background-color 150ms,border-color 150ms}.ds-row:hover .ds-row-arrow{background:var(--ks-accent,#b88a5a);border-color:var(--ks-accent,#b88a5a)}.ds-row:focus-visible{outline:3px solid var(--ks-accent-soft,#e7c99a);outline-offset:2px;box-shadow:0 0 0 2px var(--ks-navy,#001112)}"
    },
    {
      "name": "Process Steps",
      "kind": "custom",
      "description": "Numbered process columns: every badge navy with gold numerals, a bronze connector leading to the next step, none after the last.",
      "html": "<ol class=\"ds-steps\"><li><div class=\"ds-step-head\"><span class=\"ds-step-badge\">01</span><span class=\"ds-step-line\"></span></div><b>Review</b></li><li><div class=\"ds-step-head\"><span class=\"ds-step-badge\">02</span><span class=\"ds-step-line\"></span></div><b>Route</b></li><li><div class=\"ds-step-head\"><span class=\"ds-step-badge\">03</span><span class=\"ds-step-line ds-step-line-end\"></span></div><b>Execute</b></li></ol>",
